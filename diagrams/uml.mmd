classDiagram
    %% PawPal+ draft UML — keep this file updated so it matches the final implementation.

    class Owner {
        +str name
        +int available_minutes
        +str day_start
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(name: str) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +str notes
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +get_pending_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str preferred_time
        +str frequency
        +str pet_name
        +bool completed
        +mark_complete() None
        +priority_score() int
    }

    class Scheduler {
        +Owner owner
        +list~tuple~ scheduled
        +list~Task~ skipped
        +generate_plan() list~tuple~
        +sort_tasks(tasks: list~Task~) list~Task~
        +fits_in_time(task: Task, minutes_left: int) bool
        +explain_plan() str
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" *-- "*" Task : needs
    Scheduler "1" --> "1" Owner : plans for
