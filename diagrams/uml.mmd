classDiagram
    %% PawPal+ draft UML — keep this file updated so it matches the final implementation.

    class Owner {
        +str name
        +int available_minutes
        +str day_start
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(name: str) None
        +get_all_tasks() list~Task~
        +filter_tasks(pet_name: str, completed: bool) list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +str notes
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +get_pending_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str preferred_time
        +str frequency
        +date due_date
        +str pet_name
        +bool completed
        +mark_complete() Task
        +is_due(on: date) bool
        +priority_score() int
    }

    class Scheduler {
        +Owner owner
        +list~tuple~ scheduled
        +list~Task~ skipped
        +list~str~ conflicts
        +generate_plan() list~tuple~
        +detect_conflicts(tasks: list~Task~) list~str~
        +mark_task_complete(task: Task) Task
        +sort_tasks(tasks: list~Task~) list~Task~
        +sort_by_time(tasks: list~Task~) list~Task~
        +fits_in_time(task: Task, minutes_left: int) bool
        +explain_plan() str
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" *-- "*" Task : needs
    Scheduler "1" --> "1" Owner : plans for
