classDiagram
    %% PawPal+ final UML — matches pawpal_system.py.

    class Owner {
        <<dataclass>>
        +str name
        +int available_minutes
        +str day_start
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(name: str) None
        +get_all_tasks() list~Task~
        +filter_tasks(pet_name: str = None, completed: bool = None) list~Task~
    }

    class Pet {
        <<dataclass>>
        +str name
        +str species
        +int age
        +str notes
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +get_pending_tasks() list~Task~
    }

    class Task {
        <<dataclass>>
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str preferred_time
        +str frequency
        +date due_date
        +str pet_name
        +bool completed
        +mark_complete() Optional~Task~
        +is_due(on: date) bool
        +priority_score() int
    }

    class Scheduler {
        +Owner owner
        +list~tuple~ scheduled
        +list~Task~ skipped
        +list~str~ conflicts
        +generate_plan() list~tuple~
        +mark_task_complete(task: Task) Optional~Task~
        +sort_tasks(tasks: list~Task~) list~Task~
        +sort_by_time(tasks: list~Task~) list~Task~
        +detect_conflicts(tasks: list~Task~ = None) list~str~
        +fits_in_time(task: Task, minutes_left: int) bool
        +explain_plan() str
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" *-- "*" Task : needs
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> Task : sorts, schedules, checks conflicts
    Scheduler ..> Pet : adds next occurrence to
    Task ..> Task : mark_complete() creates next occurrence

    note for Task "priority: low, medium, high (PRIORITY_SCORES 1-3)\nfrequency: once, daily (+1 day), weekly (+7 days)"
    note for Scheduler "scheduled holds (start 'HH:MM', Task) pairs\nreads tasks only via Owner.get_all_tasks()\nplan is capped at midnight (MINUTES_PER_DAY)"
